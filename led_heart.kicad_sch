	(text "Microcontroller and shift register"
		(exclude_from_sim no)
		(at 15.24 70.16 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "6a2552f0-2c1a-5ecd-a3d2-d198597e2ef2")
	)
	(text "U1 drives the 9 columns (high = on) through 270 ohm. U2 selects the row: output high = row on. Its two clocks are tied together,"
		(exclude_from_sim no)
		(at 15.24 74.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3e4bb62d-51d3-5a9a-908a-28acd63d832d")
	)
	(text "so the outputs lag the shift register by one clock. J1 (not fitted): VDD, SWIM, GND, NRST for the ST-Link."
		(exclude_from_sim no)
		(at 15.24 77.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
